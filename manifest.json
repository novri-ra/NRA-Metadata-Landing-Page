{
  "manifest_version": 3,
  "name": "NRA DreamLab",
  "version": "1.1.19",
  "description": "Automate text input on canva.com/ai and download images on canva.com/dream-lab using NRA DreamLab.",
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_icon": "assets/icon.png",
    "default_title": "NRA DreamLab"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "notifications",
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.canva.com/dream-lab*"
      ],
      "js": [
        "src/utils/utils.js",
        "src/content/selectors.js",
        "src/content/content.js"
      ],
        "https://www.canva.com/dream-lab*"
      ],
      "js": [
        "selectors.js",
        "utils.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
